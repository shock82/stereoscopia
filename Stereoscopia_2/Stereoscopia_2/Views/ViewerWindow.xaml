<Window x:Class="Stereoscopia_2.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewer" Background="#0D0D0D"
        xmlns:local="clr-namespace:Stereoscopia_2.Utility"
        WindowStyle="None" AllowsTransparency="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- toolbar disegno -->
        </Grid.RowDefinitions>

        <!-- Area immagine -->
        <Grid Grid.Row="0" x:Name="ImageContainer" Background="#0D0D0D" ClipToBounds="True" SizeChanged="ImageContainer_SizeChanged"
              MouseWheel="ImageContainer_MouseWheel" MouseLeftButtonDown="ImageContainer_MouseDown" MouseLeftButtonUp="ImageContainer_MouseUp" 
              MouseMove="ImageContainer_MouseMove">

            <Image x:Name="MainImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <MatrixTransform x:Name="ImgMatrix"/>
                </Image.RenderTransform>
            </Image>

            <!-- Layer disegno: stesso transform dell'immagine -->
            <Canvas x:Name="DrawingCanvas" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="DrawMatrix"/>
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Mirino -->
            <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False"/>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" x:Name="MainToolbar" Visibility="Collapsed"
                Background="#1A1A2E" BorderThickness="0,1,0,0" BorderBrush="#0F3460"
                Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Label SX -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Comandi SX -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Sync toggle -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Comandi DX -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Label DX -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spazio -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Disegna + Chiudi -->
                </Grid.ColumnDefinitions>

                <!-- Label SX -->
                <Border Grid.Column="0" Background="#E9456022" CornerRadius="4"
                        Padding="8,3" Margin="0,0,8,0">
                    <TextBlock Text="◀ SINISTRA" Foreground="#E94560"
                               FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </Border>

                <!-- Comandi SX -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="↺" ToolTip="-90°"   Tag="L_rotL"  Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="↻" ToolTip="+90°"   Tag="L_rotR"  Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="⟷" ToolTip="FlipH"  Tag="L_flipH" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="↕" ToolTip="FlipV"  Tag="L_flipV" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="🔍+" ToolTip="Zoom+"  Tag="L_zoomI" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="🔍-" ToolTip="Zoom-"  Tag="L_zoomO" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="⌂" ToolTip="Reset"  Tag="L_reset" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                </StackPanel>

                <!-- Toggle SYNC centrale -->
                <ToggleButton Grid.Column="2" x:Name="BtnSync"
                              Content="🔗" ToolTip="Sincronizza entrambe le immagini"
                              Style="{StaticResource ToggleToolBtn}"
                              Margin="10,0" Width="40" FontSize="16"
                              Checked="BtnSync_Checked" Unchecked="BtnSync_Unchecked"/>

                <!-- Label DX -->
                <Border Grid.Column="3" Background="#4FC3F722" CornerRadius="4" Padding="8,3" Margin="8,0,0,0">
                    <TextBlock Text="DESTRA ▶" Foreground="#4FC3F7" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </Border>

                <!-- Comandi DX -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="↺" ToolTip="-90°"   Tag="R_rotL"  Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="↻" ToolTip="+90°"   Tag="R_rotR"  Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="⟷" ToolTip="FlipH"  Tag="R_flipH" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="↕" ToolTip="FlipV"  Tag="R_flipV" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="🔍+" ToolTip="Zoom+"  Tag="R_zoomI" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="🔍-" ToolTip="Zoom-"  Tag="R_zoomO" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                    <Button Content="⌂" ToolTip="Reset"  Tag="R_reset" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                </StackPanel>

                <!-- Disegna + Chiudi -->
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnDrawMode" Content="✏"
                                  ToolTip="Modalità disegno"
                                  Checked="DrawMode_Checked"
                                  Unchecked="DrawMode_Unchecked"
                                  Style="{StaticResource ToggleToolBtn}"
                                  Margin="0,0,6,0"/>
                    <Button Content="✕" ToolTip="Chiudi"
                            Click="BtnClose_Click"
                            Style="{StaticResource ToolBtn}"
                            Foreground="#E94560" Width="30"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Toolbar disegno -->
        <Border Grid.Row="2" x:Name="DrawToolbar" Visibility="Collapsed"
                Background="#12122A" Padding="8,5"
                BorderThickness="0,1,0,0" BorderBrush="#E9456033">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBlock Text="Strumento:" Foreground="#888" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="RbLine" Content="╱ Linea" GroupName="Tool" IsChecked="True" Style="{StaticResource RadioToolBtn}"/>
                <RadioButton x:Name="RbCircle" Content="○ Cerchio" GroupName="Tool" Style="{StaticResource RadioToolBtn}"/>

                <Separator Width="1" Background="#333" Margin="8,2"/>

                <TextBlock Text="Colore:" Foreground="#888" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ListBox x:Name="ColorPicker" SelectionMode="Single"
                         SelectedIndex="0" BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="ColorPicker_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Separator Width="1" Background="#333" Margin="8,2"/>

                <TextBlock Text="Spessore:" Foreground="#888" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" Value="2"
                        Width="80" VerticalAlignment="Center" Foreground="#E94560"/>
                <TextBlock Foreground="#CCC" FontSize="11" VerticalAlignment="Center"
                           Margin="4,0,8,0" Width="28"
                           Text="{Binding Value, ElementName=ThicknessSlider,
                                  StringFormat={}{0:F0}px}"/>

                <Separator Width="1" Background="#333" Margin="0,2,8,2"/>

                <Button Content="↩ Annulla"  Tag="undo"  Click="DrawCmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="🗑 Cancella" Tag="clear" Click="DrawCmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="💾 Salva"    Tag="save"  Click="DrawCmd_Click"
                        Style="{StaticResource ToolBtn}" Foreground="#4FC3F7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>