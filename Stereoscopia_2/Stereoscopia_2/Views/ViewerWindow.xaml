<Window x:Class="Stereoscopia_2.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewer" Background="#0D0D0D"
        xmlns:local="clr-namespace:Stereoscopia_2.Utility"
        WindowStyle="None" AllowsTransparency="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- toolbar disegno -->
        </Grid.RowDefinitions>

        <!-- Area immagine -->
        <Grid Grid.Row="0" x:Name="ImageContainer" Background="#0D0D0D" ClipToBounds="True" SizeChanged="ImageContainer_SizeChanged"
              MouseWheel="ImageContainer_MouseWheel" MouseLeftButtonDown="ImageContainer_MouseDown" MouseLeftButtonUp="ImageContainer_MouseUp" 
              MouseMove="ImageContainer_MouseMove">

            <Image x:Name="MainImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <MatrixTransform x:Name="ImgMatrix"/>
                </Image.RenderTransform>
            </Image>

            <!-- Layer disegno: stesso transform dell'immagine -->
            <Canvas x:Name="DrawingCanvas" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="DrawMatrix"/>
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Mirino -->
            <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False"/>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#1A1A2E" Padding="8,6"
                BorderThickness="0,1,0,0" BorderBrush="#0F3460">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBlock x:Name="TitleLabel" Foreground="#E94560" FontWeight="Bold"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="SINGOLO:" Foreground="#666" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="↺ -90°"  Tag="single_rotL"  Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="↻ +90°"  Tag="single_rotR"  Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="⟷ FlipH" Tag="single_flipH" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="↕ FlipV" Tag="single_flipV" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="🔍+"     Tag="single_zoomI" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="🔍-"     Tag="single_zoomO" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="⌂ Reset" Tag="single_reset" Click="Cmd_Click" Style="{StaticResource ToolBtn}"/>

                <Separator Width="1" Background="#444" Margin="12,2"/>

                <TextBlock Text="SYNC:" Foreground="#E94560" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="↺ -90°"  Tag="sync_rotL"  Click="Cmd_Click" Style="{StaticResource ToolBtnSync}"/>
                <Button Content="↻ +90°"  Tag="sync_rotR"  Click="Cmd_Click" Style="{StaticResource ToolBtnSync}"/>
                <Button Content="⟷ FlipH" Tag="sync_flipH" Click="Cmd_Click" Style="{StaticResource ToolBtnSync}"/>
                <Button Content="↕ FlipV" Tag="sync_flipV" Click="Cmd_Click" Style="{StaticResource ToolBtnSync}"/>
                <Button Content="🔍+"     Tag="sync_zoomI" Click="Cmd_Click" Style="{StaticResource ToolBtnSync}"/>
                <Button Content="🔍-"     Tag="sync_zoomO" Click="Cmd_Click" Style="{StaticResource ToolBtnSync}"/>
                <Button Content="⌂ Reset" Tag="sync_reset" Click="Cmd_Click" Style="{StaticResource ToolBtnSync}"/>

                <Separator Width="1" Background="#444" Margin="12,2"/>
                <Button Content="✕ Chiudi" Click="BtnClose_Click"
                        Style="{StaticResource ToolBtn}" Foreground="#E94560"/>
            </StackPanel>
        </Border>
        <!-- Toolbar disegno -->
        <Border Grid.Row="2" x:Name="DrawToolbar"
            Background="#12122A" Padding="8,5"
            BorderThickness="0,1,0,0" BorderBrush="#E9456033"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Toggle modalità disegno -->
                <ToggleButton x:Name="BtnDrawMode" Content="✏ Disegna" Checked="DrawMode_Checked" Unchecked="DrawMode_Unchecked"
                              Style="{StaticResource ToggleToolBtn}" Margin="0,0,12,0"/>

                <Separator Width="1" Background="#333" Margin="0,2,12,2"/>

                <!-- Strumento -->
                <TextBlock Text="Strumento:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="RbLine"   Content="╱ Linea"   GroupName="Tool" IsChecked="True"  Style="{StaticResource RadioToolBtn}"/>
                <RadioButton x:Name="RbCircle" Content="○ Cerchio" GroupName="Tool" Style="{StaticResource RadioToolBtn}"/>

                <Separator Width="1" Background="#333" Margin="8,2"/>

                <!-- Colore -->
                <TextBlock Text="Colore:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ListBox x:Name="ColorPicker" SelectionMode="Single" SelectedIndex="0" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Width="20" Height="20" CornerRadius="10" Background="{TemplateBinding Tag}"
                                                BorderThickness="2" BorderBrush="Transparent" Margin="2" Cursor="Hand">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="SelectionStates">
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Brushes.White}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Unselected"/>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Separator Width="1" Background="#333" Margin="8,2"/>

                <!-- Spessore -->
                <TextBlock Text="Spessore:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" Value="1" Width="80" VerticalAlignment="Center" Foreground="#E94560"/>
                <TextBlock x:Name="ThicknessLabel" Foreground="#CCC" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" Width="25"
                           Text="{Binding Value, ElementName=ThicknessSlider, StringFormat={}{0:F0}px}"/>

                <Separator Width="1" Background="#333" Margin="8,2"/>

                <!-- Annulla / Cancella tutto / Salva -->
                <Button Content="↩ Annulla" Tag="undo"  Click="DrawCmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="🗑 Cancella" Tag="clear" Click="DrawCmd_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="💾 Salva"   Tag="save"  Click="DrawCmd_Click"
                    Style="{StaticResource ToolBtn}" Foreground="#4FC3F7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>